{
  "name": "ds-bot",
  "version": "0.2.4-halfsignal.15",
  "description": "Halfsignal: a persistent Bot team for DeepSeek Harness with a native Harness interface",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "deepseek",
    "bot",
    "multi-agent",
    "agents"
  ],
  "homepage": "https://github.com/KouriVar/DeepSeek-Bot#readme",
  "bugs": {
    "url": "https://github.com/KouriVar/DeepSeek-Bot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KouriVar/DeepSeek-Bot.git",
    "directory": "ds-bot"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./web-search": "./web-search.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/host/",
    "src/shared/",
    "src/office/",
    "client.js",
    "office.js",
    "web-search.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --import ./test/harness-resolve.mjs --test \"test/*.test.js\"",
    "lint": "node scripts/lint.mjs",
    "harness": "npm install --prefix dev/harness --legacy-peer-deps=false --no-package-lock --no-fund --no-audit",
    "check": "sh dev/check.sh"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-web": "*"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "mobile": {
      "entries": [
        {
          "id": "bot",
          "title": "Bot",
          "icon": "person.2",
          "order": 10,
          "kind": "sessions",
          "filters": {
            "workspaceTitle": "DS Bot"
          }
        }
      ]
    }
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "deep-view": "0.1.0"
  }
}
